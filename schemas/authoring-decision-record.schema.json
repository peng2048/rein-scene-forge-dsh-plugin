{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rein.example/schemas/authoring-decision-record.schema.json",
  "title": "Rein Scene Forge Authoring Decision Record",
  "description": "Traceable decisions made while preserving, optimizing, or selectively transforming supplied content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "decision_record_id",
    "requirement_id",
    "processing_mode",
    "input_content_reference",
    "decisions",
    "unresolved_questions"
  ],
  "properties": {
    "contract_version": { "const": "1.0-draft" },
    "decision_record_id": { "$ref": "#/$defs/id" },
    "requirement_id": { "$ref": "#/$defs/id" },
    "processing_mode": { "enum": ["preserve", "optimize", "mixed"] },
    "input_content_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_reference_ids", "content_sha256"],
      "properties": {
        "source_reference_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "content_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decision" }
    },
    "unresolved_questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/unresolvedQuestion" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "jsonPath": { "type": "string", "pattern": "^\\$(?:\\.[a-z][a-z0-9_]*|\\[[0-9]+\\])*$" },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "operation",
        "input_path",
        "output_path",
        "rationale",
        "requirement_field_paths",
        "source_reference_ids",
        "requires_confirmation"
      ],
      "properties": {
        "decision_id": { "$ref": "#/$defs/id" },
        "operation": { "enum": ["preserve", "optimize", "omit", "reorder", "split", "merge"] },
        "input_path": { "$ref": "#/$defs/jsonPath" },
        "output_path": { "$ref": "#/$defs/jsonPath" },
        "rationale": { "$ref": "#/$defs/nonEmpty" },
        "requirement_field_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/jsonPath" }
        },
        "source_reference_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "requires_confirmation": { "type": "boolean" },
        "confirmation_source_id": { "$ref": "#/$defs/id" }
      }
    },
    "unresolvedQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "question", "affected_decision_ids", "impact", "is_blocking", "status"],
      "properties": {
        "question_id": { "$ref": "#/$defs/id" },
        "question": { "$ref": "#/$defs/nonEmpty" },
        "affected_decision_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "impact": { "$ref": "#/$defs/nonEmpty" },
        "is_blocking": { "type": "boolean" },
        "status": { "const": "open" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "processing_mode": { "const": "preserve" } } },
      "then": {
        "properties": {
          "decisions": {
            "items": {
              "properties": { "operation": { "const": "preserve" } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "processing_mode": { "const": "optimize" } } },
      "then": {
        "properties": {
          "decisions": {
            "contains": {
              "properties": { "operation": { "enum": ["optimize", "omit", "reorder", "split", "merge"] } },
              "required": ["operation"]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "processing_mode": { "const": "mixed" } } },
      "then": {
        "properties": {
          "decisions": {
            "allOf": [
              { "contains": { "properties": { "operation": { "const": "preserve" } }, "required": ["operation"] } },
              { "contains": { "properties": { "operation": { "enum": ["optimize", "omit", "reorder", "split", "merge"] } }, "required": ["operation"] } }
            ]
          }
        }
      }
    }
  ]
}
