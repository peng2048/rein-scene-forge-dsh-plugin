{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rein.example/schemas/scene-requirement.schema.json",
  "title": "Rein Scene Forge Scene Requirement",
  "description": "Confirmed authoring requirements captured before semantic planning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "requirement_id",
    "scene_identity",
    "robot_role",
    "processing_mode",
    "audiences",
    "default_language",
    "additional_languages",
    "style",
    "tone",
    "target_duration_seconds",
    "content_constraints",
    "interaction_policy",
    "target_runtime",
    "confirmation_sources",
    "defaults_applied",
    "unresolved_questions"
  ],
  "properties": {
    "contract_version": { "const": "1.0-draft" },
    "requirement_id": { "$ref": "#/$defs/id" },
    "scene_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "display_name", "purpose"],
      "properties": {
        "scene_id": { "$ref": "#/$defs/id" },
        "display_name": { "$ref": "#/$defs/nonEmpty" },
        "purpose": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "robot_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "display_name", "responsibilities"],
      "properties": {
        "role_id": { "$ref": "#/$defs/id" },
        "display_name": { "$ref": "#/$defs/nonEmpty" },
        "responsibilities": { "$ref": "#/$defs/nonEmptyList" }
      }
    },
    "processing_mode": { "enum": ["preserve", "optimize", "mixed"] },
    "audiences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["audience_id", "display_name", "needs"],
        "properties": {
          "audience_id": { "$ref": "#/$defs/id" },
          "display_name": { "$ref": "#/$defs/nonEmpty" },
          "needs": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } }
        }
      }
    },
    "default_language": { "$ref": "#/$defs/languageTag" },
    "additional_languages": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/languageTag" }
    },
    "style": { "$ref": "#/$defs/nonEmpty" },
    "tone": { "$ref": "#/$defs/nonEmpty" },
    "target_duration_seconds": { "type": "integer", "minimum": 1 },
    "content_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_cover", "prohibited", "optional_topics"],
      "properties": {
        "must_cover": { "type": "array", "items": { "$ref": "#/$defs/contentConstraint" } },
        "prohibited": { "type": "array", "items": { "$ref": "#/$defs/contentConstraint" } },
        "optional_topics": { "type": "array", "items": { "$ref": "#/$defs/contentConstraint" } }
      }
    },
    "interaction_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questions_enabled", "dwell_enabled", "photo_policy"],
      "properties": {
        "questions_enabled": { "type": "boolean" },
        "dwell_enabled": { "type": "boolean" },
        "notes": { "type": "string" },
        "photo_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "timing", "group_photo_enabled", "consent_required"],
          "properties": {
            "enabled": { "type": "boolean" },
            "timing": { "enum": ["disabled", "before_tour", "during_tour", "after_tour", "operator_selected"] },
            "group_photo_enabled": { "type": "boolean" },
            "consent_required": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "target_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_runtime_id", "target_version"],
      "properties": {
        "target_runtime_id": { "$ref": "#/$defs/id" },
        "target_version": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "confirmation_sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/confirmationSource" }
    },
    "defaults_applied": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field_path", "value", "reason", "requires_confirmation"],
        "properties": {
          "field_path": { "$ref": "#/$defs/jsonPath" },
          "value": {},
          "reason": { "$ref": "#/$defs/nonEmpty" },
          "requires_confirmation": { "type": "boolean" }
        }
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/unresolvedQuestion" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "nonEmptyList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "languageTag": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
    "jsonPath": { "type": "string", "pattern": "^\\$(?:\\.[a-z][a-z0-9_]*|\\[[0-9]+\\])*$" },
    "contentConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "statement", "source_reference_ids"],
      "properties": {
        "constraint_id": { "$ref": "#/$defs/id" },
        "statement": { "$ref": "#/$defs/nonEmpty" },
        "source_reference_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "confirmationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmation_source_id", "source_type", "source_reference", "confirmed_field_paths"],
      "properties": {
        "confirmation_source_id": { "$ref": "#/$defs/id" },
        "source_type": { "enum": ["user_interview", "source_material", "approved_default", "authoring_decision_record"] },
        "source_reference": { "$ref": "#/$defs/nonEmpty" },
        "confirmed_field_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/jsonPath" }
        }
      }
    },
    "unresolvedQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "question", "affected_field_paths", "impact", "is_blocking", "status"],
      "properties": {
        "question_id": { "$ref": "#/$defs/id" },
        "question": { "$ref": "#/$defs/nonEmpty" },
        "affected_field_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/jsonPath" }
        },
        "impact": { "$ref": "#/$defs/nonEmpty" },
        "is_blocking": { "type": "boolean" },
        "status": { "const": "open" }
      }
    }
  }
}
