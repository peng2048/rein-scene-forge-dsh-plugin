{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rein.example/schemas/scene-ir.schema.json",
  "title": "Rein Scene Forge Dynamic-Aware Scene IR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scene",
    "map_points",
    "areas",
    "programs",
    "dynamic_authoring",
    "source_references",
    "requirement_resolution",
    "generation_metadata"
  ],
  "properties": {
    "schema_version": { "const": "1.0-draft" },
    "scene": { "$ref": "#/$defs/scene" },
    "map_points": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/mapPoint" }
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/area" }
    },
    "programs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/program" }
    },
    "personas": {
      "type": "array",
      "items": { "$ref": "#/$defs/persona" }
    },
    "dynamic_authoring": { "$ref": "#/$defs/dynamicAuthoring" },
    "calendar_contents": {
      "type": "array",
      "items": { "$ref": "#/$defs/calendarContent" }
    },
    "source_references": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceReference" }
    },
    "requirement_resolution": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirementResolution" }
    },
    "generation_metadata": { "$ref": "#/$defs/generationMetadata" }
  },
  "$defs": {
    "logicalId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "idList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/logicalId" }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "display_name",
        "venue_name",
        "robot_role",
        "default_content_language",
        "language_style",
        "default_program_id",
        "runtime_policy"
      ],
      "properties": {
        "scene_id": { "$ref": "#/$defs/logicalId" },
        "display_name": { "$ref": "#/$defs/nonEmptyString" },
        "venue_name": { "$ref": "#/$defs/nonEmptyString" },
        "robot_role": { "$ref": "#/$defs/nonEmptyString" },
        "default_content_language": { "$ref": "#/$defs/nonEmptyString" },
        "language_style": { "$ref": "#/$defs/nonEmptyString" },
        "default_program_id": { "$ref": "#/$defs/logicalId" },
        "runtime_policy": { "$ref": "#/$defs/runtimePolicy" }
      }
    },
    "runtimePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoring_mode",
        "session_compiler_required",
        "default_after_point_action",
        "authoring_max_explain_points",
        "session_max_explain_points",
        "session_max_estimated_duration_seconds"
      ],
      "properties": {
        "authoring_mode": { "enum": ["static", "dynamic"] },
        "session_compiler_required": { "type": "boolean" },
        "default_after_point_action": { "$ref": "#/$defs/afterPointAction" },
        "authoring_max_explain_points": { "type": "integer", "minimum": 1 },
        "session_max_explain_points": { "type": "integer", "minimum": 1 },
        "session_max_estimated_duration_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "mapPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "map_point_key",
        "display_name",
        "navigation_point_id",
        "point_type",
        "is_accessible"
      ],
      "properties": {
        "map_point_key": { "$ref": "#/$defs/logicalId" },
        "display_name": { "$ref": "#/$defs/nonEmptyString" },
        "navigation_point_id": { "$ref": "#/$defs/nonEmptyString" },
        "debug_navigation_point_id": { "$ref": "#/$defs/nonEmptyString" },
        "point_type": { "enum": ["base", "business", "waypoint"] },
        "description": { "type": "string" },
        "is_accessible": { "type": "boolean" }
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area_id", "display_name", "description", "narrator", "explain_points"],
      "properties": {
        "area_id": { "$ref": "#/$defs/logicalId" },
        "display_name": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "narrator": { "$ref": "#/$defs/narrator" },
        "explain_points": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/explainPoint" }
        }
      }
    },
    "explainPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explain_point_id",
        "display_name",
        "narrator",
        "tags",
        "estimated_duration_seconds",
        "priority",
        "segments",
        "after_point_policy"
      ],
      "properties": {
        "explain_point_id": { "$ref": "#/$defs/logicalId" },
        "display_name": { "$ref": "#/$defs/nonEmptyString" },
        "map_point_key": { "$ref": "#/$defs/logicalId" },
        "description": { "type": "string" },
        "narrator": { "$ref": "#/$defs/narrator" },
        "tags": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "estimated_duration_seconds": { "type": "integer", "minimum": 0 },
        "priority": { "type": "integer", "minimum": 0 },
        "conditions": { "$ref": "#/$defs/conditions" },
        "movement_narration": { "$ref": "#/$defs/movementNarration" },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/segment" }
        },
        "after_point_policy": { "$ref": "#/$defs/afterPointPolicy" }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "display_name",
        "content",
        "narrator",
        "tags",
        "estimated_duration_seconds",
        "is_mandatory",
        "completion_policy"
      ],
      "properties": {
        "segment_id": { "$ref": "#/$defs/logicalId" },
        "display_name": { "$ref": "#/$defs/nonEmptyString" },
        "content": { "$ref": "#/$defs/content" },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/variant" }
        },
        "narrator": { "$ref": "#/$defs/narrator" },
        "gesture_id": { "$ref": "#/$defs/nonEmptyString" },
        "tags": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "estimated_duration_seconds": { "type": "integer", "minimum": 0 },
        "is_mandatory": { "type": "boolean" },
        "conditions": { "$ref": "#/$defs/conditions" },
        "completion_policy": { "$ref": "#/$defs/completionPolicy" },
        "shuffle_policy": { "$ref": "#/$defs/shufflePolicy" }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "content_language",
        "source_reference_ids",
        "transformation",
        "requires_confirmation"
      ],
      "properties": {
        "text": { "$ref": "#/$defs/nonEmptyString" },
        "content_language": { "$ref": "#/$defs/nonEmptyString" },
        "source_reference_ids": { "$ref": "#/$defs/idList" },
        "transformation": {
          "enum": ["verbatim", "constrained_rewrite", "generated_transition", "inferred"]
        },
        "requires_confirmation": { "type": "boolean" }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_id",
        "display_name",
        "duration_mode_id",
        "explain_point_ids",
        "default_pacing_mode",
        "photo_policy",
        "limits"
      ],
      "properties": {
        "program_id": { "$ref": "#/$defs/logicalId" },
        "display_name": { "$ref": "#/$defs/nonEmptyString" },
        "duration_mode_id": { "$ref": "#/$defs/logicalId" },
        "explain_point_ids": { "$ref": "#/$defs/idList" },
        "default_pacing_mode": { "enum": ["station", "flowing"] },
        "photo_policy": { "$ref": "#/$defs/programPhotoPolicy" },
        "conditions": { "$ref": "#/$defs/conditions" },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_explain_points", "max_estimated_duration_seconds"],
          "properties": {
            "max_explain_points": { "type": "integer", "minimum": 1 },
            "max_estimated_duration_seconds": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "programPhotoPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["photo_subgraph_timing", "allow_session_override"],
      "properties": {
        "photo_subgraph_timing": { "enum": ["disabled", "before_program", "after_program"] },
        "photo_map_point_key": { "$ref": "#/$defs/logicalId" },
        "allow_session_override": { "type": "boolean" }
      }
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persona_id",
        "display_name",
        "audience_title",
        "condition_aliases",
        "profile_recommendations",
        "pad_exposure"
      ],
      "properties": {
        "persona_id": { "$ref": "#/$defs/logicalId" },
        "display_name": { "$ref": "#/$defs/nonEmptyString" },
        "audience_title": { "$ref": "#/$defs/nonEmptyString" },
        "condition_aliases": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/logicalId" } },
        "profile_recommendations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "perspective_id": { "$ref": "#/$defs/logicalId" },
            "duration_mode_id": { "$ref": "#/$defs/logicalId" },
            "pacing_mode": { "enum": ["station", "flowing"] },
            "joke_level": { "type": "integer", "minimum": 0, "maximum": 2 },
            "recommended_interaction_enabled": { "type": "boolean" },
            "recommended_photo_enabled": { "type": "boolean" }
          }
        },
        "pad_exposure": { "$ref": "#/$defs/padExposure" }
      }
    },
    "dynamicAuthoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_dimensions",
        "template_slots",
        "language_capabilities",
        "capability_requirements"
      ],
      "properties": {
        "profile_dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/profileDimension" }
        },
        "template_slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/templateSlot" }
        },
        "language_capabilities": { "$ref": "#/$defs/languageCapabilities" },
        "capability_requirements": { "$ref": "#/$defs/capabilityRequirements" }
      }
    },
    "profileDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_dimension_id",
        "value_type",
        "is_required",
        "allow_session_override",
        "pad_exposure",
        "pii_classification"
      ],
      "properties": {
        "profile_dimension_id": { "$ref": "#/$defs/logicalId" },
        "value_type": { "enum": ["string", "integer", "number", "boolean", "string_list", "integer_map"] },
        "allowed_values": { "type": "array", "minItems": 1, "uniqueItems": true },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "scene_default": {},
        "is_required": { "type": "boolean" },
        "allow_session_override": { "type": "boolean" },
        "pad_exposure": { "$ref": "#/$defs/padExposure" },
        "pii_classification": { "enum": ["none", "low", "sensitive"] }
      }
    },
    "padExposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_visible", "is_editable"],
      "properties": {
        "is_visible": { "type": "boolean" },
        "is_editable": { "type": "boolean" }
      }
    },
    "templateSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_slot_id", "value_type", "owner", "is_required"],
      "properties": {
        "template_slot_id": { "$ref": "#/$defs/logicalId" },
        "value_type": { "enum": ["string", "integer", "number", "boolean"] },
        "owner": { "enum": ["session_profile", "compiler_context", "calendar", "target_adapter"] },
        "is_required": { "type": "boolean" },
        "fallback_value": {},
        "allowed_values": { "type": "array", "minItems": 1, "uniqueItems": true }
      }
    },
    "languageCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_languages",
        "pad_selectable_languages",
        "required_nlu_languages",
        "required_tts_languages",
        "runtime_switchable_languages"
      ],
      "properties": {
        "content_languages": { "$ref": "#/$defs/stringList" },
        "pad_selectable_languages": { "$ref": "#/$defs/stringList" },
        "required_nlu_languages": { "$ref": "#/$defs/stringList" },
        "required_tts_languages": { "$ref": "#/$defs/stringList" },
        "runtime_switchable_languages": { "$ref": "#/$defs/stringList" }
      }
    },
    "capabilityRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dynamic_session_compilation",
        "conditions",
        "variants",
        "station_approach",
        "flowing_passing",
        "calendar_hooks",
        "ask_questions",
        "dwell_continue",
        "wait_for_continue",
        "route_photo_checkpoint",
        "program_photo_subgraph",
        "interrupt_resume"
      ],
      "properties": {
        "dynamic_session_compilation": { "type": "boolean" },
        "conditions": { "type": "boolean" },
        "variants": { "type": "boolean" },
        "station_approach": { "type": "boolean" },
        "flowing_passing": { "type": "boolean" },
        "calendar_hooks": { "type": "boolean" },
        "ask_questions": { "type": "boolean" },
        "dwell_continue": { "type": "boolean" },
        "wait_for_continue": { "type": "boolean" },
        "route_photo_checkpoint": { "type": "boolean" },
        "program_photo_subgraph": { "type": "boolean" },
        "interrupt_resume": { "type": "boolean" }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "persona_ids": { "$ref": "#/$defs/idList" },
        "perspective_ids": { "$ref": "#/$defs/idList" },
        "duration_mode_ids": { "$ref": "#/$defs/idList" },
        "pacing_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["station", "flowing"] }
        },
        "interaction_enabled": { "type": "boolean" },
        "photo_enabled": { "type": "boolean" },
        "minimum_joke_level": { "type": "integer", "minimum": 0, "maximum": 2 },
        "maximum_joke_level": { "type": "integer", "minimum": 0, "maximum": 2 },
        "calendar_condition": { "$ref": "#/$defs/calendarCondition" }
      }
    },
    "calendarCondition": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "solar_term_ids": { "$ref": "#/$defs/idList" },
        "festival_ids": { "$ref": "#/$defs/idList" },
        "is_solar_term_day": { "type": "boolean" },
        "minimum_days_to_festival": { "type": "integer", "minimum": 0 },
        "maximum_days_to_festival": { "type": "integer", "minimum": 0 }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant_id", "conditions", "weight", "content"],
      "properties": {
        "variant_id": { "$ref": "#/$defs/logicalId" },
        "conditions": { "$ref": "#/$defs/conditions" },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "content": { "$ref": "#/$defs/content" },
        "gesture_id": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "movementNarration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approach": { "$ref": "#/$defs/movementMode" },
        "passing": { "$ref": "#/$defs/movementMode" }
      },
      "minProperties": 1
    },
    "movementMode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_route": { "$ref": "#/$defs/movementRoute" },
        "predecessor_overrides": {
          "type": "array",
          "items": { "$ref": "#/$defs/movementOverride" }
        },
        "allow_silent_pass": { "type": "boolean" }
      },
      "minProperties": 1
    },
    "movementRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waypoint_map_point_keys", "segments"],
      "properties": {
        "waypoint_map_point_keys": {
          "type": "array",
          "uniqueItems": false,
          "items": { "$ref": "#/$defs/logicalId" }
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/movementSegment" }
        }
      }
    },
    "movementOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predecessor_explain_point_id", "waypoint_map_point_keys", "segments"],
      "properties": {
        "predecessor_explain_point_id": { "$ref": "#/$defs/logicalId" },
        "waypoint_map_point_keys": {
          "type": "array",
          "uniqueItems": false,
          "items": { "$ref": "#/$defs/logicalId" }
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/movementSegment" }
        }
      }
    },
    "movementSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["movement_segment_id", "content", "trigger"],
      "properties": {
        "movement_segment_id": { "$ref": "#/$defs/logicalId" },
        "content": { "$ref": "#/$defs/content" },
        "conditions": { "$ref": "#/$defs/conditions" },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/variant" }
        },
        "trigger": { "$ref": "#/$defs/movementTrigger" }
      }
    },
    "movementTrigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["trigger_type"],
          "properties": { "trigger_type": { "const": "on_start" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["trigger_type", "waypoint_index"],
          "properties": {
            "trigger_type": { "const": "on_waypoint" },
            "waypoint_index": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["trigger_type", "progress_ratio"],
          "properties": {
            "trigger_type": { "const": "on_progress" },
            "progress_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      ]
    },
    "afterPointAction": {
      "enum": ["direct", "ask_questions", "dwell_continue"]
    },
    "afterPointPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "$ref": "#/$defs/afterPointAction" },
        "intro_content": { "$ref": "#/$defs/content" },
        "dwell_seconds": { "type": "integer", "minimum": 0 },
        "outro_content": { "$ref": "#/$defs/content" }
      }
    },
    "completionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["continue", "wait_for_continue", "pause_after"] },
        "prompt_content": { "$ref": "#/$defs/content" },
        "pause_after_seconds": { "type": "integer", "minimum": 0 },
        "is_silent_wait": { "type": "boolean" }
      }
    },
    "shufflePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shuffle_group_id", "pick_count", "always_keep"],
      "properties": {
        "shuffle_group_id": { "$ref": "#/$defs/logicalId" },
        "pick_count": { "type": "integer", "minimum": 1 },
        "always_keep": { "type": "boolean" }
      }
    },
    "calendarContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calendar_content_id", "template_slot_id", "conditions", "content"],
      "properties": {
        "calendar_content_id": { "$ref": "#/$defs/logicalId" },
        "template_slot_id": { "$ref": "#/$defs/logicalId" },
        "conditions": { "$ref": "#/$defs/conditions" },
        "content": { "$ref": "#/$defs/content" }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_reference_id", "source_file", "locator", "fact_classification"],
      "properties": {
        "source_reference_id": { "$ref": "#/$defs/logicalId" },
        "source_file": { "$ref": "#/$defs/nonEmptyString" },
        "locator": { "$ref": "#/$defs/nonEmptyString" },
        "fact_classification": { "enum": ["source_fact", "business_rule", "approved_template", "inference"] }
      }
    },
    "requirementResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "field_path",
        "resolved_value",
        "resolution_source",
        "confirmation_status",
        "source_reference_ids"
      ],
      "properties": {
        "requirement_id": { "$ref": "#/$defs/logicalId" },
        "field_path": { "$ref": "#/$defs/nonEmptyString" },
        "resolved_value": {},
        "resolution_source": {
          "enum": [
            "user_explicit",
            "source_material",
            "persona_recommendation",
            "program_default",
            "scene_default",
            "adapter_default"
          ]
        },
        "confirmation_status": { "enum": ["confirmed", "assumed", "requires_confirmation", "rejected"] },
        "source_reference_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/logicalId" }
        }
      }
    },
    "generationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator_id", "generator_version", "rules_version", "generation_seed"],
      "properties": {
        "generator_id": { "$ref": "#/$defs/nonEmptyString" },
        "generator_version": { "$ref": "#/$defs/nonEmptyString" },
        "rules_version": { "$ref": "#/$defs/nonEmptyString" },
        "generation_seed": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "narrator": { "enum": ["robot", "human"] }
  }
}