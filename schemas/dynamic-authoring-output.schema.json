{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rein.example/schemas/dynamic-authoring-output.schema.json",
  "title": "Rein Scene Forge Dynamic Authoring Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "authoring_package_id",
    "scene_id",
    "scene_ir_schema_version",
    "scene_ir_sha256",
    "target_adapter",
    "target_runtime",
    "rules_version",
    "compiler_capability",
    "pad_profile_schema",
    "target_files",
    "traceability",
    "diagnostics",
    "release_policy",
    "authoring_package_sha256"
  ],
  "properties": {
    "contract_version": { "const": "1.0-draft" },
    "authoring_package_id": { "$ref": "#/$defs/id" },
    "scene_id": { "$ref": "#/$defs/id" },
    "scene_ir_schema_version": { "$ref": "#/$defs/nonEmpty" },
    "scene_ir_sha256": { "$ref": "#/$defs/sha256" },
    "target_adapter": { "$ref": "#/$defs/componentIdentity" },
    "target_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_runtime_id", "supported_version_range"],
      "properties": {
        "target_runtime_id": { "$ref": "#/$defs/id" },
        "supported_version_range": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "rules_version": { "$ref": "#/$defs/nonEmpty" },
    "compiler_capability": { "$ref": "#/$defs/compilerCapability" },
    "pad_profile_schema": { "$ref": "#/$defs/padProfileSchema" },
    "target_files": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/targetFile" }
    },
    "traceability": {
      "type": "array",
      "items": { "$ref": "#/$defs/traceabilityEntry" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "release_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warning_policy", "require_confirmed_high_impact_values", "is_publishable"],
      "properties": {
        "warning_policy": { "enum": ["allow", "require_approval", "reject"] },
        "require_confirmed_high_impact_values": { "type": "boolean" },
        "is_publishable": { "type": "boolean" }
      }
    },
    "authoring_package_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "componentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "component_version"],
      "properties": {
        "component_id": { "$ref": "#/$defs/id" },
        "component_version": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "compilerCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_compiler",
        "selection_algorithm_version",
        "supported_authoring_contract_versions",
        "supported_scene_ir_versions",
        "provided_by",
        "required_context_fields",
        "features"
      ],
      "properties": {
        "session_compiler": { "$ref": "#/$defs/componentIdentity" },
        "selection_algorithm_version": { "$ref": "#/$defs/nonEmpty" },
        "supported_authoring_contract_versions": { "$ref": "#/$defs/nonEmptyList" },
        "supported_scene_ir_versions": { "$ref": "#/$defs/nonEmptyList" },
        "provided_by": { "enum": ["package", "external_reference", "target_runtime"] },
        "reference": { "type": "string" },
        "required_context_fields": { "$ref": "#/$defs/nonEmptyList" },
        "features": {
          "type": "object",
          "additionalProperties": { "enum": ["supported", "unsupported", "degraded"] }
        }
      }
    },
    "padProfileSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "fields", "cross_field_constraints"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/nonEmpty" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/padField" }
        },
        "cross_field_constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "padField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "display_name",
        "value_type",
        "is_required",
        "is_visible",
        "is_editable",
        "allow_session_override",
        "pii_classification"
      ],
      "properties": {
        "field_id": { "$ref": "#/$defs/id" },
        "display_name": { "$ref": "#/$defs/nonEmpty" },
        "description": { "type": "string" },
        "value_type": { "enum": ["string", "integer", "number", "boolean", "string_list", "integer_map"] },
        "allowed_values": { "type": "array", "minItems": 1, "uniqueItems": true },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "scene_default": {},
        "persona_recommendations": { "type": "object" },
        "is_required": { "type": "boolean" },
        "is_visible": { "type": "boolean" },
        "is_editable": { "type": "boolean" },
        "allow_session_override": { "type": "boolean" },
        "pii_classification": { "enum": ["none", "low", "sensitive"] },
        "unsupported_behavior": { "enum": ["reject", "hide", "read_only", "use_default"] }
      }
    },
    "targetFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "sha256", "purpose"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmpty" },
        "media_type": { "$ref": "#/$defs/nonEmpty" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "purpose": { "enum": ["map", "scene", "explain_authoring", "reception_pack", "calendar_hooks", "intent_contract", "other"] }
      }
    },
    "traceabilityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_ir_path", "target_file_path", "target_object_path", "source_reference_ids"],
      "properties": {
        "scene_ir_path": { "$ref": "#/$defs/nonEmpty" },
        "target_file_path": { "$ref": "#/$defs/nonEmpty" },
        "target_object_path": { "$ref": "#/$defs/nonEmpty" },
        "source_reference_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "stage", "object_path", "message", "fix_suggestion"],
      "properties": {
        "code": { "$ref": "#/$defs/nonEmpty" },
        "severity": { "enum": ["error", "warning", "info"] },
        "stage": { "$ref": "#/$defs/nonEmpty" },
        "object_path": { "$ref": "#/$defs/nonEmpty" },
        "message": { "$ref": "#/$defs/nonEmpty" },
        "fix_suggestion": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "nonEmptyList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmpty" }
    }
  }
}