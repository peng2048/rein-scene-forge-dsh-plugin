{
  "name": "rein-scene-forge-dsh-plugin",
  "version": "0.2.4",
  "description": "DeepSeek Harness Skill and deterministic validators for generating tour_robot YAML from points.json and narration material.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "skills/**/*.md",
    "skills/**/*.yaml",
    "schemas/authoring/*.schema.json",
    "schemas/tour-robot/*.schema.json",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-skill": ">=0.1.0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
